rules_version = '2';

// MODE DEMO (tanpa login) — dipublish manual oleh Owner lewat Firebase Console.
// Semua orang yang tahu URL bisa baca/tulis sampai tanggal di bawah.
// Saat login diaktifkan lagi (AppConfig.demoMode = false), publish ulang `firestore.rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 11, 10);
    }
  }
}
