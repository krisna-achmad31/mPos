rules_version = '2';

// Multi-distributor: setiap akun (users/{uid}) terikat ke satu distributorId + role.
// Semua data bisnis ada di distributors/{d}/... dan hanya bisa diakses anggota distributor itu.
// Dipakai saat login aktif (AppConfig.demoMode = false). Selama pilot tanpa login dipakai firestore.demo.rules.
//
// Catatan: stok diubah dari klien di dalam transaksi. Untuk produksi, pindahkan checkout & stok
// ke Cloud Functions agar customer tidak bisa menulis field `stock` secara langsung.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().active == true; }
    function member(d) { return active() && profile().distributorId == d; }
    function isOwner(d) { return member(d) && profile().role == 'owner'; }
    function isSpv(d) { return member(d) && profile().role == 'spv'; }
    function isCustomer(d) { return member(d) && profile().role == 'customer'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Dipakai di batch pendaftaran distributor: distributor dibuat di batch yang sama.
    function isNewOwner(d) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/distributors/$(d)).data.ownerUid == request.auth.uid;
    }
    // POS kopi: id = uid Customer pemiliknya. Owner Kopi = Customer itu sendiri; Kasir punya cafeId.
    function isCafeOwner(c) { return active() && request.auth.uid == c && profile().role == 'customer'; }
    function isCashier(c) { return active() && profile().role == 'cashier' && profile().cafeId == c; }
    function cafeMember(c) { return isCafeOwner(c) || isCashier(c); }
    // Owner distributor boleh menambah stok kopi saat menandai pesanan pelanggannya diterima.
    // getAfter: dokumen kopi bisa baru dibuat di transaksi yang sama.
    function cafeDistributorOwner(c) {
      return existsAfter(/databases/$(database)/documents/cafes/$(c))
        && isOwner(getAfter(/databases/$(database)/documents/cafes/$(c)).data.distributorId);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if isSelf(uid)
        || (signedIn() && profile().role == 'owner' && resource.data.distributorId == profile().distributorId);
      allow create: if isSelf(uid) && (
        (request.resource.data.role == 'customer'
          && exists(/databases/$(database)/documents/distributors/$(request.resource.data.distributorId)))
        || (request.resource.data.role == 'owner' && isNewOwner(request.resource.data.distributorId))
      );
      // Owner mengatur role/status akun di distributornya sendiri, tanpa memindahkan distributor.
      allow update: if (isOwner(resource.data.distributorId)
            && request.resource.data.distributorId == resource.data.distributorId)
        || (isSelf(uid) && onlyChanges(['name', 'storeName', 'phone', 'address']));
    }

    match /distributors/{d} {
      // Nama distributor publik agar pelanggan bisa memilih saat mendaftar.
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(d) && request.resource.data.ownerUid == resource.data.ownerUid;

      match /products/{id} {
        allow read: if member(d);
        allow create, delete: if isOwner(d);
        // Stok berubah lewat transaksi stok masuk, checkout, dan pembatalan.
        allow update: if isOwner(d)
          || (member(d) && onlyChanges(['stock', 'updatedAt']) && request.resource.data.stock >= 0);
      }

      // Harga beli & HPP: tidak boleh terlihat customer.
      match /product_costs/{id} {
        allow read, write: if isOwner(d) || isSpv(d);
      }

      match /price_history/{id} {
        allow read, write: if isOwner(d);
      }

      match /stock_receipts/{id} {
        allow read: if isOwner(d) || (isSpv(d) && resource.data.createdBy == request.auth.uid);
        allow create: if (isOwner(d) || isSpv(d)) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isOwner(d)
          || (isSpv(d) && resource.data.createdBy == request.auth.uid
              && onlyChanges(['status']) && request.resource.data.status == 'pending_change');
      }

      match /change_requests/{id} {
        allow read: if isOwner(d) || (isSpv(d) && resource.data.requestedBy == request.auth.uid);
        allow create: if isSpv(d) && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isOwner(d);
      }

      match /stock_movements/{id} {
        allow read: if isOwner(d);
        allow create: if member(d) && request.resource.data.userId == request.auth.uid;
      }

      match /stock_opnames/{id} {
        allow read, write: if isOwner(d);
      }

      // Harga khusus tersembunyi; customer hanya membaca promo yang tampil di katalog
      // untuk semua pelanggan ('all') atau khusus dirinya.
      match /discounts/{id} {
        allow read: if isOwner(d) || (member(d) && resource.data.visibleInCatalog == true
          && resource.data.audience in ['all', request.auth.uid]);
        allow write: if isOwner(d);
      }

      match /orders/{id} {
        allow read: if isOwner(d)
          || (isCustomer(d) && resource.data.customerId == request.auth.uid)
          || (isSpv(d) && resource.data.courierId == request.auth.uid);
        allow create: if isCustomer(d) && request.resource.data.customerId == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isOwner(d)
          // Customer: batalkan saat masih menunggu, atau konfirmasi diterima setelah terkirim.
          || (isCustomer(d) && resource.data.customerId == request.auth.uid
              && resource.data.status == 'pending'
              && request.resource.data.status == 'cancelled'
              && onlyChanges(['status', 'cancelReason', 'cancelledBy', 'cancelledAt']))
          || (isCustomer(d) && resource.data.customerId == request.auth.uid
              && resource.data.status == 'delivered'
              && request.resource.data.status == 'done'
              && onlyChanges(['status', 'doneAt', 'doneBy', 'cafeStockSynced']))
          // Kurir (SPV) yang ditugaskan: tandai terkirim.
          || (isSpv(d) && resource.data.courierId == request.auth.uid
              && resource.data.status == 'shipped'
              && request.resource.data.status == 'delivered'
              && onlyChanges(['status', 'deliveredAt', 'deliveredBy']));
      }

      match /invoices/{id} {
        allow read: if isOwner(d) || (isCustomer(d) && resource.data.customerId == request.auth.uid);
        allow write: if isOwner(d);
      }

      match /invoice_costs/{id} {
        allow read, write: if isOwner(d);
      }

      match /payments/{id} {
        allow read: if isOwner(d) || (isCustomer(d) && resource.data.customerId == request.auth.uid);
        allow create: if isOwner(d);
      }

      match /expenses/{id} {
        allow read, write: if isOwner(d);
      }

      match /counters/{id} {
        allow read, write: if isOwner(d);
      }

      match /settings/{id} {
        allow read: if member(d);
        allow write: if isOwner(d) || isNewOwner(d);
      }

      // Data contoh MODE DEMO laporan (terpisah dari nota asli).
      match /demo_days/{id} {
        allow read, write: if isOwner(d);
      }

      // Kode promo premium POS kopi. Customer membaca saat memakai kode dan hanya boleh menaikkan `used` 1.
      match /premium_codes/{code} {
        allow read: if member(d);
        allow write: if isOwner(d);
        allow update: if isCustomer(d) && onlyChanges(['used']) && request.resource.data.used == resource.data.used + 1;

        // Satu dokumen per POS kopi (id = uid Customer): kode hanya sekali per pelanggan.
        match /redemptions/{cafeId} {
          allow read: if isOwner(d) || isSelf(cafeId);
          allow create: if isCustomer(d) && isSelf(cafeId);
        }
      }

      match /audit_logs/{id} {
        allow read: if isOwner(d);
        allow create: if member(d) && request.resource.data.userId == request.auth.uid;
      }
    }

    // POS kopi milik pelanggan distributor. Catatan: `premiumUntil` ditulis klien saat memakai kode;
    // untuk produksi pindahkan aktivasi premium ke Cloud Functions agar tidak bisa dipalsukan.
    match /cafes/{c} {
      allow read: if cafeMember(c) || isOwner(resource.data.distributorId);
      allow create: if request.resource.data.ownerUid == c && (isCafeOwner(c)
        || (isOwner(request.resource.data.distributorId) && !('premiumUntil' in request.resource.data)));
      allow update: if (isCafeOwner(c) && request.resource.data.distributorId == profile().distributorId)
        || (isOwner(resource.data.distributorId) && onlyChanges(['ownerUid', 'name', 'distributorId']));

      // Bahan: stok bertambah dari pesanan distributor (Owner Kopi / Owner distributor), berkurang dari kasir.
      match /ingredients/{id} {
        allow read: if cafeMember(c);
        allow write: if isCafeOwner(c) || cafeDistributorOwner(c);
        allow update: if isCashier(c) && onlyChanges(['stock']);
      }

      match /stock_movements/{id} {
        allow read: if isCafeOwner(c);
        allow create: if (cafeMember(c) || cafeDistributorOwner(c)) && request.resource.data.userId == request.auth.uid;
      }

      // Struk kasir dan turunannya.
      match /invoices/{id} {
        allow read: if cafeMember(c);
        allow create: if cafeMember(c);
        allow update, delete: if isCafeOwner(c);
      }
      match /invoice_costs/{id} {
        allow read: if isCafeOwner(c);
        allow create: if cafeMember(c);
      }
      match /payments/{id} {
        allow read: if isCafeOwner(c);
        allow create: if cafeMember(c);
      }
      match /counters/{id} {
        allow read, write: if cafeMember(c);
      }

      // Menu, resep, pengaturan: dibaca kasir, diubah Owner Kopi.
      match /{group}/{id} {
        allow read: if cafeMember(c) && group in ['products', 'recipes', 'settings'];
        allow read, write: if isCafeOwner(c);
      }
    }
  }
}
